{
  "openapi": "3.1.0",
  "info": {
    "title": "Poll API",
    "version": "1.0.0"
  },
  "paths": {
    "/polls": {
      "get": {
        "operationId": "listPolls",
        "tags": ["polls"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of polls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "object" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Poll": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" }
        }
      }
    }
  }
}
