{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Poll",
  "type": "object",
  "required": ["id", "title", "createdAt", "options", "category"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 500 },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "isActive": { "type": "boolean", "default": true },
    "options": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/option" }
    },
    "category": {
      "anyOf": [
        { "const": "sports" },
        { "const": "other" },
        { "$ref": "#/$defs/technologyCategory" },
        { "$ref": "#/$defs/entertainmentCategory" },
        { "$ref": "#/$defs/educationCategory" }
      ]
    },
    "settings": { "$ref": "#/$defs/settings" }
  },
  "additionalProperties": false,
  "$defs": {
    "option": {
      "type": "object",
      "required": ["id", "text", "voteCount"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 100 },
        "voteCount": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "allowMultipleVotes": { "type": "boolean", "default": true },
        "requireAuthentication": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "technologyCategory": {
      "type": "object",
      "required": ["technology"],
      "properties": {
        "technology": {
          "type": "object",
          "required": ["_0"],
          "properties": {
            "_0": {
              "type": "object",
              "required": ["subTopic", "hasDemo"],
              "properties": {
                "subTopic": { "type": "string" },
                "hasDemo": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "entertainmentCategory": {
      "type": "object",
      "required": ["entertainment"],
      "properties": {
        "entertainment": {
          "type": "object",
          "required": ["_0"],
          "properties": {
            "_0": {
              "type": "object",
              "required": ["genre", "ageRating"],
              "properties": {
                "genre": { "enum": ["movies", "music", "games", "television"] },
                "ageRating": {
                  "enum": [
                    "General Audience",
                    "Parental Guidance Suggested",
                    "Parental Guidance Suggested 13+",
                    "Restricted"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "educationCategory": {
      "type": "object",
      "required": ["education"],
      "properties": {
        "education": {
          "type": "object",
          "required": ["_0"],
          "properties": {
            "_0": {
              "type": "object",
              "required": ["subject", "level"],
              "properties": {
                "subject": {
                  "enum": ["math", "science", "history", "english", "art", "music", "foreignLanguage"]
                },
                "level": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
